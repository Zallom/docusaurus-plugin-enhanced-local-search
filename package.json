{
  "name": "docusaurus-plugin-enhanced-local-search",
  "version": "1.2.0",
  "description": "Local / Offline, typo-tolerant search for Docusaurus v3: ⌘K modal, hero search bar, synonyms and 30 UI languages.",
  "author": "Zallom <matthias@fca.gg>",
  "license": "MIT",
  "homepage": "https://github.com/Zallom/docusaurus-plugin-enhanced-local-search#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zallom/docusaurus-plugin-enhanced-local-search.git"
  },
  "bugs": {
    "url": "https://github.com/Zallom/docusaurus-plugin-enhanced-local-search/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "theme",
    "theme.d.ts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.theme.build.json && node scripts/copy-theme-assets.mjs && prettier --write --log-level warn --ignore-path .prettierignore lib/theme",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.theme.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "docusaurus",
    "docusaurus-plugin",
    "docusaurus-theme",
    "docusaurus-v3",
    "search",
    "local-search",
    "offline-search",
    "full-text-search",
    "cmdk",
    "command-palette",
    "search-bar",
    "typo-tolerance",
    "fuzzy-search",
    "synonyms",
    "i18n"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "@docusaurus/core": "^3.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@docusaurus/utils-validation": "^3.0.0",
    "minisearch": "^7.2.0",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.0",
    "@docusaurus/tsconfig": "^3.10.0",
    "@docusaurus/types": "^3.10.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "prettier": "^3.9.9",
    "tsup": "^8.0.0",
    "typescript": "~5.6.2"
  }
}
